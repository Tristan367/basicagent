# Nothing in this file is required. Every key here can be set on the Settings
# page instead, which is where a user will do it -- this exists for a developer
# who would rather keep keys out of the database, and for scripted runs.
#
# Copy to `.env` to use it.

# ── API keys ────────────────────────────────────────────────────────────────
# Gemini has a free tier: https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=

# ── Server ──────────────────────────────────────────────────────────────────
# HOST is 127.0.0.1 for a reason: this app has no login and runs shell commands
# as whoever started it. Changing it exposes a terminal to the network.
# HOST=127.0.0.1
# PORT=8220

# ── Where things live ───────────────────────────────────────────────────────
# The database, the projects, the log and the downloaded speech models. Point
# this at a scratch directory to run against a throwaway install.
# BASICAGENT_DATA_DIR=
# BASICAGENT_PROJECTS_DIR=

# ── Logging ─────────────────────────────────────────────────────────────────
# BASICAGENT_LOG_LEVEL=INFO      # DEBUG | INFO | WARNING | ERROR

# ── Dictation (faster-whisper; installed by pip, no system packages) ─────────
# The model is chosen in Settings; this only sets the starting value.
# FASTER_WHISPER_MODEL=small.en    # tiny.en | base.en | small.en
# FASTER_WHISPER_COMPUTE=int8

# ── Read-aloud (Kokoro) ─────────────────────────────────────────────────────
# The installer downloads these. Set them only to use your own copies.
# TTS_MODEL=
# TTS_VOICES=
# TTS_DEFAULT_VOICE=af_aoede

# ── Agent limits ────────────────────────────────────────────────────────────
# MAX_TOOL_RESULT_CHARS=50000
# COMPACT_THRESHOLD_TOKENS=262144
# SUBAGENT_MAX_ROUNDS=20
