# Required: DeepSeek API key.
# If unset, the key saved through the web UI (Settings page) is used.
DEEPSEEK_API_KEY=

# Other providers (also settable from the Settings page)
# Gemini has a free tier -- get a key at https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=

# Server
# HOST=127.0.0.1
# PORT=8220

# Data lives under ~/.local/share/basicagent by default. Override to point a
# test run at a scratch database.
# BASICAGENT_DATA_DIR=
# BASICAGENT_PROJECTS_DIR=

# Speech to text (faster-whisper; installed by pip, no system packages).
# The model is chosen in Settings; this only sets the starting value.
# FASTER_WHISPER_MODEL=base.en      # tiny.en | base.en | small.en
# FASTER_WHISPER_COMPUTE=int8

# Text to speech (Kokoro; put kokoro-v1.0.onnx and voices-v1.0.bin in ~/models/tts)
# TTS_MODEL=
# TTS_VOICES=
# TTS_DEFAULT_VOICE=af_aoede

# Agent limits
# MAX_TOOL_ROUNDS=40
# MAX_TOOL_RESULT_CHARS=50000
# COMPACT_THRESHOLD_TOKENS=262144
